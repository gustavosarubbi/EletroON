# ============================================
# ConfiguraÃ§Ãµes do Backend - EletroON
# ============================================
# Copie este arquivo para .env e configure as variÃ¡veis

# Banco de Dados PostgreSQL
# Configure com suas credenciais locais do PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/database?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eletroon?schema=public

# JWT - AutenticaÃ§Ã£o
# IMPORTANTE: Altere este valor em produÃ§Ã£o para um segredo forte e aleatÃ³rio
JWT_SECRET=sua-chave-secreta-jwt-super-segura-altere-em-producao-2024
JWT_EXPIRATION_TIME=24h

# Servidor
PORT=3000
NODE_ENV=development

# CORS - Origens permitidas (use * para permitir todas ou liste separado por vÃ­rgula)
CORS_ORIGINS=*

# UsuÃ¡rios PadrÃ£o
# Estes usuÃ¡rios serÃ£o criados automaticamente na primeira inicializaÃ§Ã£o
DEFAULT_ADMIN_EMAIL=admin@eletroon.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_USER_EMAIL=usuario@eletroon.com
DEFAULT_USER_PASSWORD=User@123
