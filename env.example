# 🔐 Configurações do Sistema EletroON
# Copie este arquivo para .env e configure suas credenciais

# ===========================================
# ⚠️  IMPORTANTE: SEGURANÇA
# ===========================================
# 1. NUNCA commite o arquivo .env no Git
# 2. Use senhas fortes e únicas
# 3. Mantenha este arquivo .env.example atualizado

# ===========================================
# 🗄️  BANCO DE DADOS
# ===========================================
POSTGRES_PASSWORD=sua_senha_super_segura_aqui
DATABASE_URL=postgresql://postgres:sua_senha_super_segura_aqui@db:5432/eletroon

# ===========================================
# 🔑 AUTENTICAÇÃO JWT
# ===========================================
JWT_SECRET=seu-jwt-secret-super-seguro-e-unico-aqui
JWT_EXPIRATION_TIME=24h

# ===========================================
# 👤 USUÁRIOS PADRÃO
# ===========================================
# Configure os usuários que serão criados automaticamente
DEFAULT_ADMIN_EMAIL=admin@seudominio.com
DEFAULT_ADMIN_PASSWORD=SenhaAdmin123!@#
DEFAULT_USER_EMAIL=usuario@seudominio.com
DEFAULT_USER_PASSWORD=SenhaUser123!@#

# ===========================================
# 🌐 CONFIGURAÇÕES DE REDE
# ===========================================
CORS_ORIGINS=*
NODE_ENV=production
PORT=3000

# ===========================================
# 📱 FRONTEND (se necessário)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:3000/api
